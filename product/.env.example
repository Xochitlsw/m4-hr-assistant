# HR Assistant: todas las variables del producto, con sus valores por omision (salvo
# HIDE_INPUTS y HIDE_OUTPUTS, que van con el valor de este despliegue).
# Copia este archivo a .env y llenalo en tu editor. Nunca subas .env al repositorio
# ni pegues sus valores en un chat. Los secretos van vacios aqui.

# Modelo: fake (simulado, sin red) o gateway (Cloudflare Workers AI via AI Gateway)
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
# Validacion de entradas y salidas: mensajes de historial aceptados, largo maximo de
# la respuesta (y de cada mensaje assistant del historial) y tope del cuerpo en bytes
MAX_HISTORY_MESSAGES=20
MAX_ANSWER_CHARS=2000
MAX_BODY_BYTES=65536
EMPLOYEES_PATH=data/employees.json

# Observabilidad
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000
LANGSMITH_TRACING=false
# Secreto: clave de LangSmith (tipo Tracing Only)
LANGSMITH_API_KEY=
# Proyecto de LangSmith: uno por entorno (desarrollo aqui; produccion en render.yaml)
LANGSMITH_PROJECT=m4-hr-assistant-dev
# Trazas: true oculta, redact manda redactado (datos personales y secretos) y false en
# claro (produccion no lo acepta con trazas). Por omision true; este despliegue usa redact
HIDE_INPUTS=redact
HIDE_OUTPUTS=redact

# Cloudflare (obligatorias con MODEL_PROVIDER=gateway)
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
# Secreto: token de Workers AI
CF_API_TOKEN=

# Palancas de costo
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
MODEL_TIMEOUT_SECONDS=30
# Resiliencia del modelo real: conexion, reintentos con backoff y circuit breaker
MODEL_CONNECT_TIMEOUT_SECONDS=5
MODEL_MAX_RETRIES=2
MODEL_RETRY_BACKOFF_SECONDS=0.5
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_SECONDS=30
# Cache del gateway en segundos: 0 la salta; produccion usa 300 (render.yaml), maximo 900
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json

# Seguridad
# development o production (production aplica las reglas de compliance y no arranca
# si alguna falla)
ENVIRONMENT=development
# Secreto: clientes y claves con la forma cliente:clave,cliente2:clave2
# (en production, claves de 16 caracteres o mas)
API_KEYS=
RATE_LIMIT_PER_MINUTE=30
# Claves fallidas por origen por minuto antes de responder 429 sin comparar la clave
AUTH_FAILURES_PER_MINUTE=10
# Proxies de confianza delante de la app: 0 en local; 1 en Render (X-Forwarded-For)
TRUSTED_PROXY_HOPS=0
# Presupuesto de costo por cliente por dia UTC, en USD (0 lo apaga; produccion exige > 0)
CLIENT_DAILY_BUDGET_USD=1.0
# El contenedor escucha en PORT (8000 por omision; Render lo define)

# Herramientas (la aplicacion no las lee)
# Secreto: clave de un cliente para scripts/smoke.py y la verificacion production.
# Mejor leela sin eco en la consola justo antes de usarla (README, Despliegue)
SMOKE_API_KEY=
