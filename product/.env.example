# HR Assistant: todas las variables del producto, con sus valores por omision.
# Copia este archivo a .env y llenalo en tu editor. Nunca subas .env al repositorio
# ni pegues sus valores en un chat. Los secretos van vacios aqui.

# Modelo: fake (simulado, sin red) o gateway (Cloudflare Workers AI via AI Gateway)
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
EMPLOYEES_PATH=data/employees.json

# Observabilidad
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000
LANGSMITH_TRACING=false
# Secreto: clave de LangSmith (tipo Tracing Only)
LANGSMITH_API_KEY=
# Proyecto de LangSmith (opcional); descomentalo para elegirlo
# LANGSMITH_PROJECT=hr-assistant
HIDE_INPUTS=true
HIDE_OUTPUTS=true

# Cloudflare (obligatorias con MODEL_PROVIDER=gateway)
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
# Secreto: token de Workers AI
CF_API_TOKEN=

# Palancas de costo
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
MODEL_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json
