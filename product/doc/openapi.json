{
  "openapi": "3.1.0",
  "info": {
    "title": "HR Assistant",
    "description": "HR Assistant: an agent that answers questions about employees from the HR directory,\nwith two read-only tools (`get_employee`, `search_by_department`).\n\n**Authentication**: `POST /ask` and `GET /metrics` need the header `X-API-Key` with the\nkey of a client (use **Authorize**). `/`, `/health`, `/ready` and `/docs` need no key.\n\n**Limits**: body up to 64 KiB, question up to 2000 characters, history up to 20\nmessages; per-client rate limit and daily cost budget; failed keys are limited per\norigin. Every response carries `X-Request-ID`, to find the request in logs and traces.\n\n**Privacy**: personal data in questions is redacted before the model; a secret or a\nprompt injection is rejected with `400`. Logs never contain the text of questions or\nanswers.\n",
    "version": "1.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "page"
        ],
        "summary": "HR Assistant web page",
        "description": "Page for HR staff; the key lives only in `sessionStorage`.",
        "operationId": "home__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Operations dashboard",
        "description": "Page with the metrics of this process (it reads `GET /metrics` with the key of a client, kept only in `sessionStorage`). The page has no data.",
        "operationId": "operations_dashboard_dashboard_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Liveness: the process answers",
        "description": "Cheap check for the platform; no key and no external calls.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Readiness: data loaded and a model available",
        "description": "`200` if the directory is loaded and at least one model circuit is not open; `503` otherwise. Never calls the model.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "503": {
            "description": "Not ready: every model circuit is open",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Latency, errors, tokens, cost and SLO",
        "description": "Metrics of this process (each worker has its own).",
        "operationId": "process_metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Process Metrics Metrics Get"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong `X-API-Key`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "example": {
                  "detail": "invalid or missing API key"
                }
              }
            }
          },
          "429": {
            "description": "Too many failed keys from this origin",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before trying again",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "example": {
                  "detail": "too many failed authentication attempts"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/ask": {
      "post": {
        "tags": [
          "ask"
        ],
        "summary": "Ask the HR Assistant",
        "description": "Routes the question to a model, runs the agent with its read-only tools and answers with the model, the route and the cost.",
        "operationId": "ask_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "400": {
            "description": "The question or the history contain a secret or look like a prompt injection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "example": {
                  "detail": "request looks like a prompt injection; ask about employees"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong `X-API-Key`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "example": {
                  "detail": "invalid or missing API key"
                }
              }
            }
          },
          "413": {
            "description": "Body larger than `MAX_BODY_BYTES` (checked before reading it)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "example": {
                  "detail": "request body too large"
                }
              }
            }
          },
          "429": {
            "description": "Too many questions per minute, too many failed keys from this origin, or the client's daily budget is spent",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before trying again",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "example": {
                  "detail": "rate limit exceeded"
                }
              }
            }
          },
          "502": {
            "description": "The model failed after its retries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "example": {
                  "detail": "model unavailable"
                }
              }
            }
          },
          "503": {
            "description": "The model circuit is open: it failed several times in a row",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before trying again",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "example": {
                  "detail": "model temporarily unavailable"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "description": "Question for the HR assistant"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "maxItems": 20,
            "title": "History",
            "description": "Previous turns of the conversation, oldest first"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest",
        "description": "Cuerpo de ``POST /ask``: la pregunta y el historial opcional.",
        "examples": [
          {
            "history": [
              {
                "content": "¿Quién es EMP-0004?",
                "role": "user"
              },
              {
                "content": "Jorge Díaz, Desarrollador en Tecnología.",
                "role": "assistant"
              }
            ],
            "question": "¿Quiénes trabajan en Finanzas?"
          }
        ]
      },
      "AskResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer",
            "description": "Answer for the HR staff, in Spanish"
          },
          "steps": {
            "type": "integer",
            "title": "Steps",
            "description": "Model calls used by the agent"
          },
          "tools_used": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tools Used",
            "description": "Tools executed, in order"
          },
          "input_tokens": {
            "type": "integer",
            "title": "Input Tokens",
            "description": "Input tokens of all model calls"
          },
          "output_tokens": {
            "type": "integer",
            "title": "Output Tokens",
            "description": "Output tokens of all model calls"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id",
            "description": "Id to trace this request in logs and traces"
          },
          "model": {
            "type": "string",
            "title": "Model",
            "description": "Model chosen by the router"
          },
          "route": {
            "type": "string",
            "title": "Route",
            "description": "Why the router chose that model"
          },
          "cached_calls": {
            "type": "integer",
            "title": "Cached Calls",
            "description": "Model calls answered by the gateway cache"
          },
          "cost_usd": {
            "type": "number",
            "title": "Cost Usd",
            "description": "Cost of this answer in USD"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "steps",
          "tools_used",
          "input_tokens",
          "output_tokens",
          "request_id",
          "model",
          "route",
          "cached_calls",
          "cost_usd"
        ],
        "title": "AskResponse",
        "description": "Respuesta de ``POST /ask``.",
        "examples": [
          {
            "answer": "Jorge Díaz es Desarrollador en Tecnología, activo.",
            "cached_calls": 0,
            "cost_usd": 1.455e-05,
            "input_tokens": 127,
            "model": "@cf/meta/llama-3.1-8b-instruct-fast",
            "output_tokens": 23,
            "request_id": "3f0c8f3e-6b1a-4f7e-9d2b-7c1e2a9b5d10",
            "route": "simple",
            "steps": 2,
            "tools_used": [
              "get_employee"
            ]
          }
        ]
      },
      "ErrorBody": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "What went wrong, in English"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id",
            "description": "Id of the request (on 500, 502 and 503)"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorBody",
        "description": "Cuerpo de un error de la API."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "description": "The process answers"
          },
          "pid": {
            "type": "integer",
            "title": "Pid",
            "description": "Process that answered (state is per process)"
          }
        },
        "type": "object",
        "required": [
          "status",
          "pid"
        ],
        "title": "HealthResponse",
        "description": "Respuesta de ``GET /health``.",
        "examples": [
          {
            "pid": 7,
            "status": "ok"
          }
        ]
      },
      "Message": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "Message",
        "description": "Un turno del historial que manda el cliente."
      },
      "ReadyChecks": {
        "properties": {
          "directory": {
            "type": "string",
            "title": "Directory",
            "description": "`ok` if the employee directory is loaded"
          },
          "prices": {
            "type": "string",
            "title": "Prices",
            "description": "`ok` if every model has a price"
          },
          "models": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Models",
            "description": "Circuit of each model: `closed`, `open` or `half_open`"
          }
        },
        "type": "object",
        "required": [
          "directory",
          "prices",
          "models"
        ],
        "title": "ReadyChecks",
        "description": "Comprobaciones de ``GET /ready``."
      },
      "ReadyResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "description": "`ready` if the data is loaded and a model circuit is not open"
          },
          "checks": {
            "$ref": "#/components/schemas/ReadyChecks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "description": "Respuesta de ``GET /ready``.",
        "examples": [
          {
            "checks": {
              "directory": "ok",
              "models": {
                "@cf/meta/llama-3.1-8b-instruct-fast": "closed"
              },
              "prices": "ok"
            },
            "status": "ready"
          }
        ]
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "description": "API key of the client",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  },
  "tags": [
    {
      "name": "ask",
      "description": "Questions to the HR agent"
    },
    {
      "name": "operations",
      "description": "Health, readiness and metrics"
    },
    {
      "name": "page",
      "description": "Web page for HR staff"
    }
  ]
}
